# ================================================================
# Court Booking Revenue Simulator — Environment Configuration
# ================================================================

# 1. Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# If left blank, server runs in Dev Mode with simulated test login
GOOGLE_CLIENT_ID=

# 2. Server-Side Allowed Users Whitelist (Comma-separated emails)
# Only authenticated Google accounts in this list can access Simulator.html
ALLOWED_USERS=admin@example.com,founder@yourdomain.com,karthik@example.com

# 3. Optional: Allowed Domains (Comma-separated)
# e.g., yourcompany.com will allow any user @yourcompany.com
ALLOWED_DOMAINS=

# 4. Session Cryptographic Secret Key
# Secret used to sign HttpOnly session cookies with HMAC-SHA256
SESSION_SECRET=simulator-secure-secret-key-change-this-for-production-98765

# 5. Server Port
PORT=8000

# 6. Dev Mode (true/false)
# When true, shows developer test login buttons on /login page
DEV_MODE=true
